+            .unwrap();
+        let mut headers = (1..=2)
+            .map(|number| snapshot.get_verifiable_header_by_number(number).unwrap())
+            .collect::<Vec<_>>();
+        headers[bad_index] = header_with_overflowing_total_difficulty(headers[bad_index].clone());
