+#
+# Keep [advisories.ignore] consistent with .cargo/audit.toml: same RUSTSEC
+# IDs, same reasons. cargo-deny's advisory matching does not detect three of
+# these (RUSTSEC-2026-0306, RUSTSEC-2026-0253, RUSTSEC-2026-0186) against the
+# locked versions the way cargo-audit does; they are kept here anyway so both
+# tools' ignore lists read the same, and cargo-deny only emits a harmless
+# "advisory-not-detected" note for them, not a failure.
+
 [advisories]
 ignore = [
-    { id = "RUSTSEC-2024-0370", reason = "Pulled in transitively through ckb-tx-pool -> multi_index_map; no safe upgrade is available in the current ckb 1.x dependency line." },
-    { id = "RUSTSEC-2024-0437", reason = "Pulled in transitively through ckb-network -> ckb-metrics -> prometheus; prometheus 0.13 pins protobuf 2.x and the current ckb 1.x dependency line does not expose a compatible upgrade." },
-    { id = "RUSTSEC-2024-0436", reason = "Pulled in transitively through ckb-types and other ckb 1.x crates; no safe upgrade is available in the current dependency line." },
-    { id = "RUSTSEC-2024-0384", reason = "Pulled in transitively through jsonrpc-http-server and ckb-shared -> sled; no safe upgrade is available in the current dependency line." },
-    { id = "RUSTSEC-2020-0016", reason = "Pulled in transitively through jsonrpc-http-server 18; no safe upgrade is available without replacing the RPC server dependency." },
-    { id = "RUSTSEC-2025-0057", reason = "Pulled in transitively through ckb-shared -> sled; no safe upgrade is available in the current ckb 1.x dependency line." },
-    { id = "RUSTSEC-2025-0119", reason = "Pulled in transitively through ckb-db-migration -> indicatif 0.16; no safe upgrade is available in the current ckb 1.x dependency line." },
-    { id = "RUSTSEC-2025-0141", reason = "bincode 1.3 is used directly and transitively by the current serialization format; no safe drop-in upgrade is available." },
+    { id = "RUSTSEC-2024-0437", reason = "protobuf recursion; inspected metrics path encodes only, prometheus 0.13 pins protobuf 2; upstream metrics migration required. Review by 2026-12-28." },
+    { id = "RUSTSEC-2026-0374", reason = "basic-toml unmaintained in Askama/UniFFI binding generation; advisory reports maintenance status, no specific vulnerable operation; generator migration required. Review by 2026-12-28." },
+    { id = "RUSTSEC-2025-0141", reason = "bincode 1.3.3 unmaintained; direct runtime/storage serialization retained for format compatibility, replacement requires migration; advisory reports maintenance status, no specific vulnerable operation. Review by 2026-12-28." },
+    { id = "RUSTSEC-2025-0057", reason = "fxhash unmaintained, transitive hashing utility, no known vulnerability. Review by 2026-12-28." },
+    { id = "RUSTSEC-2024-0384", reason = "instant unmaintained, transitive via parking_lot/governor. Review by 2026-12-28." },
+    { id = "RUSTSEC-2025-0119", reason = "number_prefix unmaintained, transitive build-time dependency only. Review by 2026-12-28." },
+    { id = "RUSTSEC-2024-0436", reason = "paste unmaintained, proc-macro helper, no known vulnerability. Review by 2026-12-28." },
+    { id = "RUSTSEC-2024-0370", reason = "proc-macro-error unmaintained, build-time proc-macro dependency only. Review by 2026-12-28." },
+    { id = "RUSTSEC-2026-0306", reason = "faster-hex 0.6 AVX2 unchecked decode; shipped ARM excludes AVX2, no direct mobile call found; x86 emulator qualification separate. Review by 2026-12-28." },
+    { id = "RUSTSEC-2026-0253", reason = "lru 0.7 pop panic safety; inspected CKB verification cache uses Byte32 keys with no panicking Drop; upstream major update required. Review by 2026-12-28." },
+    { id = "RUSTSEC-2026-0186", reason = "memmap2 0.5 via cacache/chain-spec; no affected range advise/flush call found in inspected cache path; upstream major update required. Review by 2026-12-28." },
+    { id = "RUSTSEC-2026-0097", reason = "rand 0.7 via ckb-vm/numext: custom RNG-reentrant logger required; 0.8/0.9 fixed. Review by 2026-12-28." },
 ]
 
 [licenses]
@@ -15,23 +29,49 @@ allow = [
     "0BSD",
     "Apache-2.0",
     "Apache-2.0 WITH LLVM-exception",
+    "BSD-1-Clause",
     "BSD-2-Clause",
     "BSD-3-Clause",
     "BSL-1.0",
     "CC0-1.0",
     "ISC",
+    "LGPL-2.1-or-later",
     "MIT",
