+/// Fetch status for a transaction, as a JSON string; queues the fetch when unknown.
+#[uniffi::export]
+pub fn fetch_transaction(hash: String) -> Result<String, LightClientError> {
+    query::fetch_transaction(&hash).map_err(Into::into)
+}
