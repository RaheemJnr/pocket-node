+/// Fetch header (with fetch status)
+#[no_mangle]
+pub extern "C" fn Java_com_nervosnetwork_ckblightclient_LightClientNative_nativeFetchHeader(
+    mut env: JNIEnv,
+    _class: JClass,
+    hash: JString,
