+/// Verify a JSON transaction and queue it for broadcast; returns its hash as JSON.
+#[uniffi::export]
+pub fn send_transaction(tx_json: String) -> Result<String, LightClientError> {
+    query::send_transaction(&tx_json).map_err(Into::into)
+}
