 ]
-confidence-threshold = 0.8
+
+# light-client-db-common is the retained upstream WASM helper crate (see
+# wasm/light-client-db-common/Cargo.toml), with no standalone license file.
+# It is not compiled into the native mobile libraries.
+[[licenses.clarify]]
+crate = "light-client-db-common"
+expression = "MIT"
+license-files = []
+
+[licenses.private]
+ignore = true
 
 [bans]
+# Upstream CKB crates duplicate a lot of transitive dependencies (rand,
+# windows-*, syn, thiserror, ...) across major versions; that is normal for a
+# workspace this size and not something we control here, so warn only.
 multiple-versions = "warn"
+# light-client-lib depends on light-client-db-common via a path dependency
+# with no version requirement, which cargo-deny's wildcard check treats the
+# same as a "*" version wildcard. Setting wildcards = "deny" with
+# allow-wildcard-paths = true still fails here because cargo-deny refuses
+# allow-wildcard-paths for crates it considers publishable (crates.io itself
+# disallows path deps on publish), and this vendored workspace's Cargo.toml
+# does not set publish = false. Falling back to "allow" rather than editing
+# the vendored manifest.
 wildcards = "allow"
 
 [sources]
-unknown-registry = "warn"
-unknown-git = "warn"
+unknown-registry = "deny"
+unknown-git = "deny"
 allow-registry = ["https://github.com/rust-lang/crates.io-index"]
+# No git dependencies are used anywhere in this workspace's Cargo.lock today.
+allow-git = []
