+}
+
+/// Get local node info
+#[no_mangle]
+pub extern "C" fn Java_com_nervosnetwork_ckblightclient_LightClientNative_nativeLocalNodeInfo(
+    mut env: JNIEnv,
+    _class: JClass,
+) -> jstring {
