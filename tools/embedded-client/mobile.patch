+
+/// Get scripts
+#[no_mangle]
+pub extern "C" fn Java_com_nervosnetwork_ckblightclient_LightClientNative_nativeGetScripts(
+    mut env: JNIEnv,
+    _class: JClass,
+) -> jstring {
+    guard_jni(std::ptr::null_mut(), move || {
+        match bridge_query::get_scripts() {
+            Ok(json) => json_to_jstring(&mut env, &json),
+            Err(_) => ptr::null_mut(),
