index 0000000000000000000000000000000000000000..83849575790e062a7ce0eefa0013a77b81148981
--- /dev/null
+++ b/.cargo/audit.toml
@@ -0,0 +1,27 @@
+# cargo-audit config. Read from .cargo/audit.toml relative to the working
+# directory (external/ckb-light-client) by the supply-chain CI workflow and by
+# `cargo audit` run locally from this directory.
+#
+# Exceptions cover upstream dependencies, binding-generation tooling, and
+# direct runtime/storage serialization. Each reason states its scope; an
+# unmaintained notice is a maintenance exception, not a claim of general safety.
+# Review each by the date noted and remove it after a compatible migration.
+#
+# Keep this list consistent with deny.toml's [advisories.ignore]: the same
+# RUSTSEC IDs, same reasons.
+
+[advisories]
+ignore = [
+    "RUSTSEC-2024-0437", # protobuf recursion; inspected metrics path encodes only, prometheus 0.13 pins protobuf 2; upstream metrics migration required. Review by 2026-12-28.
+    "RUSTSEC-2026-0374", # basic-toml unmaintained in Askama/UniFFI binding generation; advisory reports maintenance status, no specific vulnerable operation; generator migration required. Review by 2026-12-28.
+    "RUSTSEC-2025-0141", # bincode 1.3.3 unmaintained; direct runtime/storage serialization retained for format compatibility, replacement requires migration; advisory reports maintenance status, no specific vulnerable operation. Review by 2026-12-28.
+    "RUSTSEC-2025-0057", # fxhash unmaintained, transitive hashing utility, no known vulnerability. Review by 2026-12-28.
+    "RUSTSEC-2024-0384", # instant unmaintained, transitive via parking_lot/governor. Review by 2026-12-28.
+    "RUSTSEC-2025-0119", # number_prefix unmaintained, transitive build-time dependency only. Review by 2026-12-28.
+    "RUSTSEC-2024-0436", # paste unmaintained, proc-macro helper, no known vulnerability. Review by 2026-12-28.
+    "RUSTSEC-2024-0370", # proc-macro-error unmaintained, build-time proc-macro dependency only. Review by 2026-12-28.
+    "RUSTSEC-2026-0306", # faster-hex 0.6 AVX2 unchecked decode; shipped ARM excludes AVX2, no direct mobile call found; x86 emulator qualification separate. Review by 2026-12-28.
+    "RUSTSEC-2026-0253", # lru 0.7 pop panic safety; inspected CKB verification cache uses Byte32 keys with no panicking Drop; upstream major update required. Review by 2026-12-28.
+    "RUSTSEC-2026-0186", # memmap2 0.5 via cacache/chain-spec; no affected range advise/flush call found in inspected cache path; upstream major update required. Review by 2026-12-28.
+    "RUSTSEC-2026-0097", # rand 0.7 via ckb-vm/numext: custom RNG-reentrant logger required; 0.8/0.9 fixed. Review by 2026-12-28.
+]
