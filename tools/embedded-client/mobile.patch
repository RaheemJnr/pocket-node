+    let net_controller = NET_CONTROL.get().ok_or_else(|| {
+        error!("Network controller not initialized");
+        BridgeError::Network("network controller not initialized".to_owned())
+    })?;
+
+    let _consensus = CONSENSUS.get().ok_or_else(|| {
