+            .received(nc.context(), peer, message.as_bytes())
+            .await;
+        assert!(nc.banned_since(peer, StatusCode::InvalidTotalDifficulty));
+        assert!(peers.get_state(&peer).unwrap().get_prove_state().is_none());
+        assert!(nc.sent_messages().borrow().is_empty());
